# Supabase — copy this file to `.env.local` and fill in real values.
# Found in Supabase dashboard → Project Settings → API.
# These are safe to expose to the browser (the anon key is public by design;
# Row Level Security is what protects your data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Demo mode. Set to "true" to run the whole app on local state with NO backend
# and NO sign-in required — shops/services/plans come from the hardcoded catalog
# and bookings/favourites/wallet live in localStorage (the original demo
# behaviour). Leave unset/false for the real backend-driven app, where booking,
# favouriting and topping up require a signed-in user.
NEXT_PUBLIC_DEMO_MODE=false

# --- PayOS payment gateway (server-only secrets) --------------------------
# From the PayOS dashboard → Developer. DO NOT prefix with NEXT_PUBLIC — these
# must never reach the browser. Until all three are set, the checkout/webhook
# routes return a "payments_not_configured" error and the rest of the app still
# runs (top-up/booking just can't take real money yet).
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Supabase service-role key (dashboard → Project Settings → API). SERVER-ONLY —
# it BYPASSES Row Level Security and is used by the PayOS webhook to credit
# wallets and confirm bookings. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL used to build the PayOS return/cancel URLs. The webhook is
# registered in PayOS at <SITE_URL>/api/payos/webhook. Falls back to the
# request origin if unset.
NEXT_PUBLIC_SITE_URL=https://prismawashgo.vercel.app

# --- Dev wallet unlock (LOCAL DEVELOPMENT ONLY — never set in production) ---
# Lets you credit your own signed-in test account with fake funds via a button on
# the Top-up screen, instead of going through real PayOS checkout.
#
# DO NOT set these in production. Even if you did, the /api/dev/add-funds route
# hard-refuses whenever NODE_ENV=production (which every real build/deploy sets),
# and the underlying dev_add_funds RPC is service-role-only, so a customer can
# never reach it. These two flags are the local-only switches:
#
#   DEV_WALLET_UNLOCK            server-only gate — the REAL switch. Without it the
#                               route 404s. NOT prefixed with NEXT_PUBLIC, so it
#                               never reaches the browser.
#   NEXT_PUBLIC_DEV_WALLET_UNLOCK  cosmetic — only controls whether the dev button
#                               renders. The server gate above is what enforces it.
DEV_WALLET_UNLOCK=false
NEXT_PUBLIC_DEV_WALLET_UNLOCK=false
