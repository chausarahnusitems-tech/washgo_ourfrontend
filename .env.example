# Supabase — copy this file to `.env.local` and fill in real values.
# Found in Supabase dashboard → Project Settings → API.
# These are safe to expose to the browser (the anon key is public by design;
# Row Level Security is what protects your data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Demo mode. Set to "true" to run the whole app on local state with NO backend
# and NO sign-in required — shops/services/plans come from the hardcoded catalog
# and bookings/favourites/wallet live in localStorage (the original demo
# behaviour). Leave unset/false for the real backend-driven app, where booking,
# favouriting and topping up require a signed-in user.
NEXT_PUBLIC_DEMO_MODE=false
